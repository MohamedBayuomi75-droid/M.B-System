    {
      "code": "VOUCHER-ALLOC", "name": "سند قبض/صرف وتوزيعه", "module": "treasury", "specRef": "6.1–6.3",
      "description": "التوزيع على المستندات ماينفعش يتعدّى متبقي كل مستند ولا قيمة السند. الزيادة = دفعة مقدمة غير مخصّصة (لو مسموحة).",
      "variables": { "allocations": "list", "VoucherAmount": "money", "PreviousPartyBalance": "money" },
      "lists": { "allocations": ["Amount", "DocumentRemaining"] },
      "steps": [
        { "name": "AllocationsValid", "kind": "check", "expr": "REQUIRE(SUM(allocations, IF(Amount <= 0 OR Amount > DocumentRemaining, 1, 0)) = 0, 'ALLOCATION_EXCEEDS_REMAINING')" },
        { "name": "AllocatedTotal", "expr": "SUM(allocations, Amount)" },
        { "name": "WithinVoucher", "kind": "check", "expr": "REQUIRE(AllocatedTotal <= VoucherAmount, 'ALLOCATIONS_EXCEED_VOUCHER')" },
        { "name": "UnallocatedAdvance", "expr": "VoucherAmount - AllocatedTotal" },
        { "name": "PartyRemainingBalance", "expr": "PreviousPartyBalance - VoucherAmount" }
      ],
      "testCases": [
        { "name": "قبض موزّع على فاتورتين + مقدم", "inputs": { "allocations": [{ "Amount": "600", "DocumentRemaining": "700" }, { "Amount": "300", "DocumentRemaining": "300" }], "VoucherAmount": "1000", "PreviousPartyBalance": "2000" },
