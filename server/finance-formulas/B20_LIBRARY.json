          "expected": { "GrossSales": "1000.000000", "InvoiceTotal": "1140.000000", "CustomerOutstanding": "640.000000" } }
      ],
      "openDecisions": ["هل فيه فواتير مبيعات غير المستخلصات؟"]
    },
    {
