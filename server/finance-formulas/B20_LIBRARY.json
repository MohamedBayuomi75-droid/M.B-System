    {
      "code": "CUS-CERT", "name": "مستخلص عميل", "module": "contracts", "specRef": "5.1",
      "description": "كل أساس (الاحتجاز، استرداد المقدم) مدخل مستقل من بنود العقد المعتمدة. الضرائب المضافة من B-21.",
      "variables": { "lines": "list", "AdditionalWorkValue": "money", "RetentionBase": "money", "ContractRetentionRate": "rate", "AdvanceRecoveryBase": "money", "ContractRecoveryRate": "rate", "Penalties": "money", "ContractualDeductions": "money", "OtherApprovedDeductions": "money", "AddedTaxes": "money" },
      "lists": { "lines": ["ExecutedQuantity", "ContractUnitPrice"] },
      "steps": [
        { "name": "ExecutedWorkValue", "expr": "SUM(lines, ROUND(ExecutedQuantity * ContractUnitPrice, 4))" },
        { "name": "GrossWorkValue", "expr": "ExecutedWorkValue + AdditionalWorkValue" },
        { "name": "RetentionAmount", "expr": "RetentionBase * ContractRetentionRate" },
        { "name": "AdvanceRecovery", "expr": "AdvanceRecoveryBase * ContractRecoveryRate" },
        { "name": "NetCertificate", "expr": "GrossWorkValue + AddedTaxes - RetentionAmount - AdvanceRecovery - Penalties - ContractualDeductions - OtherApprovedDeductions" }
      ],
      "testCases": [
        { "name": "مستخلص باحتجاز واسترداد مقدم وغرامة", "inputs": { "lines": [{ "ExecutedQuantity": "1000", "ContractUnitPrice": "50" }], "AdditionalWorkValue": "5000", "RetentionBase": "55000", "ContractRetentionRate": "0.05", "AdvanceRecoveryBase": "55000", "ContractRecoveryRate": "0.10", "Penalties": "500", "ContractualDeductions": "0", "OtherApprovedDeductions": "0", "AddedTaxes": "7700" },
          "expected": { "ExecutedWorkValue": "50000.000000", "GrossWorkValue": "55000.000000", "RetentionAmount": "2750.000000", "AdvanceRecovery": "5500.000000", "NetCertificate": "53950.000000" } }
      ],
      "openDecisions": ["المواصفات بتحسب المستخلص كفترة، وTR-11 المعتمد تراكمي — CERT-CUMULATIVE بيكمّلها؛ محتاج تأكيد الطريقة الرسمية", "أساس الاحتجاز وأساس ق.م (إجمالي الأعمال؟ قبل ولا بعد الإضافات؟)", "معنى taxPct في البيانات الحالية"]
    },
    {
      "code": "CERT-CUMULATIVE", "name": "المستخلصات التراكمية والمتبقي من العقد", "module": "contracts", "specRef": "5.2",
      "variables": { "ContractValue": "money", "ApprovedVariations": "money", "PreviousApprovedGross": "money", "CurrentCertificateGross": "money", "CurrentCertificateDeductions": "money" },
      "lists": {},
      "steps": [
        { "name": "CumulativeApprovedGrossCertificates", "expr": "PreviousApprovedGross + CurrentCertificateGross" },
