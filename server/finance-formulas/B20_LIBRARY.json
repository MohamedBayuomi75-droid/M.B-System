        { "name": "تجاوز قيمة العقد ← مرفوض", "inputs": { "ContractValue": "1000000", "ApprovedVariations": "50000", "PreviousApprovedGross": "600000", "CurrentCertificateGross": "450000.0001", "CurrentCertificateDeductions": "0" }, "expectError": "CERTIFICATES_EXCEED_CONTRACT" }
      ],
      "openDecisions": []
    },
