        { "name": "RemainingContractValue", "expr": "ContractValue + ApprovedVariations - CumulativeApprovedGrossCertificates" },
        { "name": "CurrentNetCertificate", "expr": "CurrentCertificateGross - CurrentCertificateDeductions" }
      ],
      "testCases": [
