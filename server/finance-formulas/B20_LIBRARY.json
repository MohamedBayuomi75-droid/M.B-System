{
  "_readme": "مكتبة معادلات B-20 الأولية (من مواصفات المستخدم 2026-11-17). **مقترحة — مش معتمدة**: بتتدخل كمسودات بس (npm run formulas:drafts) وبتتعتمد من مستخدم غير المنشئ بعد قرار المدير المالي. النسب في المدخلات كسور عشرية (0.05 = 5%) زي صيغ المواصفات (× Rate). الضرائب (VAT/WHT/الدمغة) مدخلات جاية من محرك B-21 المعتمد — مفيش حساب ضريبي هنا. التقريب: money = 4 خانات HALF_UP، qty = 5 خانات (B-26)، check = شرط.",
  "formulas": [
    {
      "code": "DOC-TOTALS", "name": "إجماليات المستند (البنود والخصومات والصافي)", "module": "common", "specRef": "2.1–2.4",
      "description": "إجمالي البنود ← خصم البند (نسبة ثم قيمة) ← خصم المستند ← الصافي ← الإجمالي ← صافي المستحق. مفيش خصم يتجاوز أساسه.",
      "variables": { "lines": "list", "DocumentDiscount": "money", "AddedTaxes": "money", "AddedFees": "money", "WithholdingTaxes": "money", "ContractualDeductions": "money", "AdvancesApplied": "money", "PreviousPayments": "money" },
      "lists": { "lines": ["Quantity", "UnitPrice", "DiscountRate", "LineDiscountAmount"] },
      "steps": [
        { "name": "GrossSubtotal", "expr": "SUM(lines, ROUND(Quantity * UnitPrice, 4))" },
        { "name": "LineDiscountsWithinBase", "kind": "check", "expr": "REQUIRE(SUM(lines, IF(ROUND(ROUND(Quantity * UnitPrice, 4) * DiscountRate, 4) + LineDiscountAmount > ROUND(Quantity * UnitPrice, 4), 1, 0)) = 0, 'LINE_DISCOUNT_EXCEEDS_LINE')" },
        { "name": "TotalLineDiscount", "expr": "SUM(lines, ROUND(ROUND(Quantity * UnitPrice, 4) * DiscountRate, 4) + LineDiscountAmount)" },
        { "name": "DocumentDiscountWithinBase", "kind": "check", "expr": "REQUIRE(DocumentDiscount <= GrossSubtotal - TotalLineDiscount, 'DOCUMENT_DISCOUNT_EXCEEDS_BASE')" },
        { "name": "TotalDiscount", "expr": "TotalLineDiscount + DocumentDiscount" },
        { "name": "NetSubtotal", "expr": "GrossSubtotal - TotalDiscount" },
        { "name": "DocumentTotal", "expr": "NetSubtotal + AddedTaxes + AddedFees" },
        { "name": "NetPayable", "expr": "DocumentTotal - WithholdingTaxes - ContractualDeductions - AdvancesApplied - PreviousPayments" }
      ],
      "testCases": [
        { "name": "عادي: خصم بند بنسبة + خصم بند بقيمة + خصم مستند", "inputs": { "lines": [{ "Quantity": "10", "UnitPrice": "100", "DiscountRate": "0.05", "LineDiscountAmount": "0" }, { "Quantity": "2", "UnitPrice": "50", "DiscountRate": "0", "LineDiscountAmount": "10" }], "DocumentDiscount": "40", "AddedTaxes": "140", "AddedFees": "0", "WithholdingTaxes": "10", "ContractualDeductions": "0", "AdvancesApplied": "100", "PreviousPayments": "30" },
          "expected": { "GrossSubtotal": "1100.000000", "TotalLineDiscount": "60.000000", "TotalDiscount": "100.000000", "NetSubtotal": "1000.000000", "DocumentTotal": "1140.000000", "NetPayable": "1000.000000" } },
        { "name": "تقريب HALF_UP على مستوى السطر", "inputs": { "lines": [{ "Quantity": "3", "UnitPrice": "0.33335", "DiscountRate": "0", "LineDiscountAmount": "0" }], "DocumentDiscount": "0", "AddedTaxes": "0", "AddedFees": "0", "WithholdingTaxes": "0", "ContractualDeductions": "0", "AdvancesApplied": "0", "PreviousPayments": "0" },
          "expected": { "GrossSubtotal": "1.000100", "NetPayable": "1.000100" } },
        { "name": "كمية صفر", "inputs": { "lines": [{ "Quantity": "0", "UnitPrice": "100", "DiscountRate": "0", "LineDiscountAmount": "0" }], "DocumentDiscount": "0", "AddedTaxes": "0", "AddedFees": "0", "WithholdingTaxes": "0", "ContractualDeductions": "0", "AdvancesApplied": "0", "PreviousPayments": "0" },
          "expected": { "GrossSubtotal": "0.000000", "DocumentTotal": "0.000000" } },
        { "name": "خصم المستند أكبر من الأساس ← مرفوض", "inputs": { "lines": [{ "Quantity": "1", "UnitPrice": "100", "DiscountRate": "0", "LineDiscountAmount": "0" }], "DocumentDiscount": "100.0001", "AddedTaxes": "0", "AddedFees": "0", "WithholdingTaxes": "0", "ContractualDeductions": "0", "AdvancesApplied": "0", "PreviousPayments": "0" },
          "expectError": "DOCUMENT_DISCOUNT_EXCEEDS_BASE" },
        { "name": "خصم السطر أكبر من السطر ← مرفوض", "inputs": { "lines": [{ "Quantity": "1", "UnitPrice": "100", "DiscountRate": "0.5", "LineDiscountAmount": "60" }], "DocumentDiscount": "0", "AddedTaxes": "0", "AddedFees": "0", "WithholdingTaxes": "0", "ContractualDeductions": "0", "AdvancesApplied": "0", "PreviousPayments": "0" },
          "expectError": "LINE_DISCOUNT_EXCEEDS_LINE" }
      ],
      "openDecisions": ["ترتيب تطبيق الخصومات المتعددة (المقترح: نسبة البند ← قيمة البند ← خصم المستند)", "التقريب على مستوى السطر (المقترح) ولا المستند"]
    },
    {
      "code": "SUP-INVOICE", "name": "فاتورة مورد", "module": "suppliers", "specRef": "3.1",
      "description": "الضرائب (InputVAT/WithholdingAmount) جاية من محرك B-21 — الخصم تحت الحساب مش خصم تجاري.",
      "variables": { "lines": "list", "CommercialDiscounts": "money", "InputVAT": "money", "OtherAddedTaxes": "money", "Fees": "money", "WithholdingAmount": "money", "AdvancesApplied": "money", "OtherApprovedDeductions": "money" },
      "lists": { "lines": ["Quantity", "UnitPrice"] },
      "steps": [
        { "name": "GrossInvoice", "expr": "SUM(lines, ROUND(Quantity * UnitPrice, 4))" },
        { "name": "DiscountWithinBase", "kind": "check", "expr": "REQUIRE(CommercialDiscounts <= GrossInvoice, 'DISCOUNT_EXCEEDS_BASE')" },
        { "name": "NetItems", "expr": "GrossInvoice - CommercialDiscounts" },
        { "name": "InvoiceTotal", "expr": "NetItems + InputVAT + OtherAddedTaxes + Fees" },
        { "name": "NetSupplierPayable", "expr": "InvoiceTotal - WithholdingAmount - AdvancesApplied - OtherApprovedDeductions" }
      ],
      "testCases": [
        { "name": "مثال المواصفات 12.2: 100,000 + ق.م 14,000 − خصم 1,000", "inputs": { "lines": [{ "Quantity": "1", "UnitPrice": "100000" }], "CommercialDiscounts": "0", "InputVAT": "14000", "OtherAddedTaxes": "0", "Fees": "0", "WithholdingAmount": "1000", "AdvancesApplied": "0", "OtherApprovedDeductions": "0" },
          "expected": { "GrossInvoice": "100000.000000", "NetItems": "100000.000000", "InvoiceTotal": "114000.000000", "NetSupplierPayable": "113000.000000" } },
        { "name": "سطور بكسور + خصم تجاري (مثال المراجعة F-01)", "inputs": { "lines": [{ "Quantity": "10", "UnitPrice": "125.5" }, { "Quantity": "3.5", "UnitPrice": "40.12345" }], "CommercialDiscounts": "27.9086", "InputVAT": "191.4533", "OtherAddedTaxes": "0", "Fees": "0", "WithholdingAmount": "13.6752", "AdvancesApplied": "0", "OtherApprovedDeductions": "0" },
          "expected": { "GrossInvoice": "1395.432100", "NetItems": "1367.523500", "InvoiceTotal": "1558.976800", "NetSupplierPayable": "1545.301600" } },
        { "name": "دفعة مقدمة مطبّقة", "inputs": { "lines": [{ "Quantity": "2", "UnitPrice": "500" }], "CommercialDiscounts": "0", "InputVAT": "140", "OtherAddedTaxes": "0", "Fees": "0", "WithholdingAmount": "10", "AdvancesApplied": "300", "OtherApprovedDeductions": "0" },
          "expected": { "NetSupplierPayable": "830.000000" } }
      ],
      "openDecisions": ["الخصم تحت الحساب عند الفاتورة ولا عند الدفع", "قابلية خصم ق.م لكل فئة مشتريات"]
    },
    {
      "code": "SUP-RETURN", "name": "مرتجع مشتريات", "module": "suppliers", "specRef": "3.2",
      "description": "بسعر الوحدة الأصلي، والضريبة من قواعد B-21 المطبّقة على المعاملة الأصلية (ReturnVAT مدخل). الكمية المرتجعة ماتتعداش الأصلية.",
      "variables": { "lines": "list", "RelatedDiscounts": "money", "ReturnVAT": "money", "OtherApplicableTaxes": "money" },
      "lists": { "lines": ["ReturnQuantity", "OriginalQuantity", "OriginalUnitPrice"] },
      "steps": [
        { "name": "ReturnWithinOriginal", "kind": "check", "expr": "REQUIRE(SUM(lines, IF(ReturnQuantity > OriginalQuantity, 1, 0)) = 0, 'RETURN_QTY_EXCEEDS_ORIGINAL')" },
        { "name": "ReturnGross", "expr": "SUM(lines, ROUND(ReturnQuantity * OriginalUnitPrice, 4))" },
        { "name": "ReturnNet", "expr": "ReturnGross - RelatedDiscounts" },
        { "name": "ReturnTotal", "expr": "ReturnNet + ReturnVAT + OtherApplicableTaxes" }
      ],
      "testCases": [
        { "name": "مرتجع جزئي", "inputs": { "lines": [{ "ReturnQuantity": "2", "OriginalQuantity": "10", "OriginalUnitPrice": "100" }], "RelatedDiscounts": "10", "ReturnVAT": "26.6", "OtherApplicableTaxes": "0" },
          "expected": { "ReturnGross": "200.000000", "ReturnNet": "190.000000", "ReturnTotal": "216.600000" } },
        { "name": "مرتجع أكبر من الأصل ← مرفوض", "inputs": { "lines": [{ "ReturnQuantity": "11", "OriginalQuantity": "10", "OriginalUnitPrice": "100" }], "RelatedDiscounts": "0", "ReturnVAT": "0", "OtherApplicableTaxes": "0" },
          "expectError": "RETURN_QTY_EXCEEDS_ORIGINAL" }
      ],
      "openDecisions": ["الأثر الضريبي للمرتجع (TR-03: مفيش أثر لحد سياسة الضرائب)"]
    },
    {
      "code": "SUP-BALANCE", "name": "رصيد المورد", "module": "suppliers", "specRef": "3.3",
      "description": "الموجب = علينا للمورد. تحصيلات من المورد (collect — TR-05) بتزوّد. الدفعات غير المصنّفة مابتدخلش (B-53).",
      "variables": { "OpeningBalance": "money", "PostedInvoices": "money", "PostedReturns": "money", "PostedPayments": "money", "PostedCollections": "money", "PostedCreditAdjustments": "money", "PostedDebitAdjustments": "money" },
      "lists": {},
      "steps": [
        { "name": "SupplierBalance", "expr": "OpeningBalance + PostedInvoices - PostedReturns - PostedPayments + PostedCollections - PostedCreditAdjustments + PostedDebitAdjustments" }
      ],
      "testCases": [
