        { "name": "دفع زيادة ← رصيد مدين (سالب)", "inputs": { "OpeningBalance": "0", "PostedInvoices": "100", "PostedReturns": "0", "PostedPayments": "150", "PostedCollections": "0", "PostedCreditAdjustments": "0", "PostedDebitAdjustments": "0" }, "expected": { "SupplierBalance": "-50.000000" } }
      ],
      "openDecisions": ["اتجاه التسويات: المواصفات (− دائنة + مدينة) عكس طبيعة حساب المورد الدائن — محتاج تأكيد المعنى", "إضافة التحصيلات من المورد (TR-05) — مش موجودة في صيغة المواصفات"]
    },
    {
      "code": "CUS-INVOICE", "name": "فاتورة عميل", "module": "customers", "specRef": "4.1",
      "variables": { "lines": "list", "Discounts": "money", "OutputVAT": "money", "OtherAddedTaxes": "money", "Fees": "money", "PostedReceipts": "money", "CreditNotes": "money", "ApprovedAdjustments": "money" },
      "lists": { "lines": ["Quantity", "UnitPrice"] },
