# بيئة التطوير (المرحلة 4) — انسخها لـ server/.env.development (ممنوع ترفع). القيم دي للتطوير بس، مش أسرار حقيقية.
NODE_ENV=development
DATABASE_URL=postgres://unified:devpass@localhost:55432/unified
DB_MIGRATIONS_RUN=true
PORT=3000
