{
  "name": "unified-system",
  "productName": "النظام الموحد",
  "version": "1.3.53",
  "description": "النظام الموحد 1.1.1 — رؤوس موحّدة + CSS مدمج + فلاتر موحّدة",
  "main": "main.js",
  "author": "النظام الموحد",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node tools/check-structure.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "test": "node tools/test-security.js",
    "test:ui": "node tests-merge/run-all.js",
    "inventory": "node tools/web/inventory.js",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "server:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "server:down": "docker compose -f docker/docker-compose.yml down",
    "gen:collections": "node tools/web/gen-server-collections.js",
    "build:web": "node tools/web/build-web.js",
    "test:ui:web": "npm --prefix server run build && WEB_MODE=1 node tests-merge/run-all.js",
    "test:web": "npm --prefix server run build && node tests-web/web-e2e.js",
    "build:app": "npm --prefix frontend run build",
    "test:app": "npm --prefix server run build && npm --prefix frontend run build && node tests-web/app-e2e.js",
    "test:ui:web:cutover": "npm --prefix server run build && WEB_MODE=1 WEB_CUTOVER=parties node tests-merge/run-all.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.unified-system",
    "productName": "النظام الموحد",
    "copyright": "Copyright © النظام الموحد",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "icon.png",
      "icon.ico",
      "package.json",
      "vendor/**/*"
    ],
    "extraMetadata": {
      "name": "unified-system"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Unified-System-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "النظام الموحد",
      "uninstallDisplayName": "النظام الموحد",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "menuCategory": false,
      "deleteAppDataOnUninstall": false
    },
    "icon": "build/icon.ico"
  }
}
