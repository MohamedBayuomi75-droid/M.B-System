# انسخ الملف ده لـ docker/.env وغيّر القيم. ممنوع رفع .env على git.
# الدليل الكامل: docs/OPERATIONS_SECURITY_BACKUP.md
NODE_ENV=production

# ---- القاعدة ----
DB_USER=unified
DB_NAME=unified
# مالك القاعدة (الـ migrations والنسخ بس) — openssl rand -base64 24
DB_PASSWORD=change-me-strong-owner-password
# دور التطبيق unified_app (السيرفر بيتصل بيه — أقل صلاحية، مايقدرش يعدّل سجل التدقيق) — openssl rand -base64 24
DB_APP_PASSWORD=change-me-strong-app-password

# ---- السيرفر ----
# openssl rand -base64 48   (32 حرف على الأقل)
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
LOG_LEVEL=info
# Swagger مقفول في الإنتاج (Nginx كمان بيرجّع 404 لـ /api/docs)
SWAGGER_ENABLED=false

# ---- المصادقة ----
# كلمة مرور أول admin لو الداتابيز فاضية (10 حروف على الأقل) — لازم تتغير أول دخول.
ADMIN_INITIAL_PASSWORD=
COOKIE_SECURE=true
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=14
LOGIN_RATE_LIMIT_PER_MIN=5
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# التحقق بخطوتين: الأدوار اللي لازم تفعّله (مفصولة بفاصلة). الافتراضي admin.
REQUIRE_2FA_ROLES=admin
# مفتاح تشفير أسرار 2FA (32 بايت) — openssl rand -hex 32 . لو فاضي بيتشتق من JWT_SECRET (وتغيير JWT_SECRET وقتها يلغي تسجيلات 2FA)
TOTP_ENC_KEY=

# ---- المرفقات (B-59) ----
ATTACH_MAX_MB=25

# ---- HTTPS / Nginx (B-57) ----
# اسم السيرفر على شبكة الشركة (لازم يكون ضمن أسماء الشهادة)
SERVER_NAME=erp.company.local
# مجلد الشهادات اللي طلّعه tools/ops/internal-ca.sh (fullchain.crt + server.key)
CERT_DIR=/srv/erp/certs
HTTPS_PORT=443
HTTP_PORT=80

# ---- النسخ الاحتياطي (B-63…B-66) ----
# مجلد على جهاز تخزين منفصل عن قرص النظام (B-66): نسخ كاملة + WAL كل 15 دقيقة
BACKUP_DIR=/mnt/backup-disk/erp
# مجلد مركّب من جهاز/NAS تاني داخل الشركة — النسخة المشفّرة خارج السيرفر
OFFSITE_DIR=/mnt/nas/erp-backup
# مفتاح التشفير: node docker/backup/crypt.mjs keygen /srv/erp/backup.key — واحتفظ بنسخة منه بعيد عن السيرفر (B-67)
BACKUP_KEY_FILE=/srv/erp/backup.key
# موعد النسخة الكاملة اليومية (cron) — توقيت TZ
BACKUP_FULL_CRON=30 1 * * *
TZ=Africa/Cairo
KEEP_DAILY_DAYS=30
KEEP_WEEKLY=12
KEEP_MONTHLY=12
