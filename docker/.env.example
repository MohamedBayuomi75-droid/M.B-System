# انسخ الملف ده لـ docker/.env وغيّر القيم. ممنوع رفع .env على git.
NODE_ENV=production
DB_USER=unified
DB_NAME=unified
# openssl rand -base64 24
DB_PASSWORD=change-me-strong-db-password
# openssl rand -base64 48   (32 حرف على الأقل)
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
LOG_LEVEL=info
# Swagger على /api/docs — اقفله في الإنتاج
SWAGGER_ENABLED=true
SERVER_PORT=3000

# ---- المصادقة (A2) ----
# كلمة مرور أول admin لو الداتابيز فاضية (10 حروف على الأقل). لو فاضية بتتولّد عشوائي وتظهر مرة واحدة في:
#   docker compose -f docker/docker-compose.yml logs server | grep admin
# في الحالتين لازم تتغير أول دخول.
ADMIN_INITIAL_PASSWORD=
# الكوكي Secure: سيبها true. المتصفحات بتقبلها على http://localhost، وفي الإنتاج Caddy بيوفّر HTTPS (A9).
# false بس للتجربة على http لعنوان غير localhost.
COOKIE_SECURE=true
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=14
LOGIN_RATE_LIMIT_PER_MIN=5
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
