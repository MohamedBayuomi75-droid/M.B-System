# Nginx أمام السيرفر — المرحلة 2 (S-3، ADR-008، B-57: شهادة من Internal CA).
# القالب بيتملى من env عند تشغيل الحاوية (nginx:alpine /etc/nginx/templates): ${SERVER_NAME}
server_tokens off;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream erp_server {
    server server:3000;
    keepalive 16;
}

# HTTP → HTTPS دايمًا (مفيش محتوى على HTTP)
server {
    listen 80;  # IPv6: أضف «listen [::]:80;» لو الشبكة بتدعمه
    server_name _;
    return 301 https://$host$request_uri;  # المنفذ القياسي 443 (لو HTTPS_PORT غيره عدّل هنا)
}

server {
    listen 443 ssl;  # IPv6: أضف «listen [::]:443 ssl;»
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 25MB للمرفق (B-59) + هامش للـ multipart — والمزامنة الكبيرة (20MB JSON)
    client_max_body_size 30m;
    client_body_timeout 60s;
    keepalive_timeout 65s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    proxy_hide_header Strict-Transport-Security;  # السيرفر بيبعتها كمان — نسخة واحدة من Nginx

    # Socket.IO (التحديث اللحظي)
    location /api/stream/ {
        proxy_pass http://erp_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://erp_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 120s;
        proxy_request_buffering on;
    }

    # Swagger مش للشبكة في الإنتاج (SWAGGER_ENABLED=false كمان)
    location /api/docs { return 404; }
}
